{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-process-kit.dev/schemas/task-record.schema.json",
  "title": "Agent Process Kit task record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "recordVersion", "request", "requestedBoundary", "status", "phase", "mode", "specGeneration", "planGeneration", "checkpointGeneration", "checkpointEvents", "artifacts", "decisions", "storyGraph", "leases", "evidence", "authorizationIntents", "grants", "externalAttempts", "pendingDecisions", "followUps", "lastTrace", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
    "recordVersion": { "type": "integer", "minimum": 0 },
    "request": { "type": "string", "minLength": 1 },
    "requestedBoundary": { "enum": ["local", "commit", "push", "deploy", "production"] },
    "status": { "enum": ["active", "parked", "blocked", "paused", "cancelled", "complete", "rolled-back"] },
    "phase": { "enum": ["intake", "clarify", "spec-draft", "spec-review", "plan-draft", "plan-review", "implement", "code-review", "local-uat", "release-ready", "release", "production-uat", "observe", "close"] },
    "mode": { "enum": ["quick", "standard", "full-train"] },
    "specGeneration": { "type": "integer", "minimum": 0 },
    "planGeneration": { "type": "integer", "minimum": 0 },
    "checkpointGeneration": { "type": "integer", "minimum": 0 },
    "checkpointEvents": { "type": "array" },
    "artifacts": { "type": "array" },
    "decisions": { "type": "array" },
    "storyGraph": { "type": ["object", "null"] },
    "leases": { "type": "array" },
    "evidence": { "type": "array" },
    "authorizationIntents": { "type": "array" },
    "grants": { "type": "array" },
    "externalAttempts": { "type": "array" },
    "pendingDecisions": { "type": "array" },
    "followUps": { "type": "array" },
    "lastTrace": { "type": ["object", "null"] },
    "completedAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
