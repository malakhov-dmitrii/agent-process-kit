{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-process-kit.dev/schemas/receipt.schema.json",
  "title": "Agent Process Kit evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptId", "taskId", "candidateIdentity", "producer", "scenario", "coverage", "startedAt", "completedAt", "verdict"],
  "properties": {
    "receiptId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "candidateIdentity": { "type": "object" },
    "environmentIdentity": { "type": "object" },
    "producer": { "type": "object" },
    "scenario": { "type": "string", "minLength": 1 },
    "coverage": { "oneOf": [{ "const": "full-candidate" }, { "type": "array", "minItems": 1 }] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "verdict": { "enum": ["pass", "fail", "missing", "stale", "unknown"] },
    "fixtureIdentity": { "type": "object" },
    "outputHashes": { "type": "array" },
    "impactProof": { "type": "object" }
  }
}
